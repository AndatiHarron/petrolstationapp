{
  "expo": {
    "name": "Nozzle",
    "slug": "petrol-management-system",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "scheme": "petrol-integrity",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Nozzle uses the camera to photograph pump meters as evidence when a shift is closed.",
          "photosPermission": "Nozzle needs access to your photos so a saved meter photo can be attached as evidence."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#ffffff",
            "image": "./assets/splash.png"
          }
        }
      ]
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.octane.petrolintegrity",
      "supportsTablet": true
    },
    "android": {
      "package": "com.andorainnovations.petrolintegrity",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "versionCode": 1
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a967a9ab-6c91-4a1e-a913-6160e4448766"
      }
    },
    "owner": "harronandati"
  }
}
