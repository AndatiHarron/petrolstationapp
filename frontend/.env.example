# Base URL of the Laravel API, including the /api suffix.
# The generated client requests paths like /login and /v1/shifts, so the
# suffix must be present or every request 404s.
#
# Local development against a phone on the same wifi: use the computer's
# LAN address, not localhost — localhost on the phone means the phone.
#   EXPO_PUBLIC_BASE_URL=http://192.168.1.20:8000/api
#
# Production:
EXPO_PUBLIC_BASE_URL=https://your-domain.example/api
