# ─────────────────────────────────────────────────────────────
# Production environment template.
# Copy to .env on the host and fill in the blanks. Never commit
# the filled-in file — .env is gitignored for this reason.
# ─────────────────────────────────────────────────────────────

APP_NAME="Petrol Integrity System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Logging ──────────────────────────────────────────────────
# `stderr` so the hosting platform collects logs instead of them
# accumulating on an ephemeral container filesystem.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Database ─────────────────────────────────────────────────
# PostgreSQL, not SQLite. SQLite takes a global write lock, so two
# managers locking a shift at the same moment would collide.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ── Sessions / cache / queue ─────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# ── File storage (IMPORTANT) ─────────────────────────────────
# Meter evidence photos MUST go to object storage. On a container
# host the local disk is wiped on every redeploy, which would
# destroy the tamper-evidence the whole system depends on.
FILESYSTEM_DISK=s3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Set this when using an S3-compatible provider (R2, Spaces, MinIO):
# AWS_ENDPOINT=https://...

# ── Debug tooling: OFF in production ─────────────────────────
# Telescope records request/query history. It filters by environment
# and hides sensitive fields outside local, but it still writes rows
# on every request and exposes a browsable UI. Keep it off.
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false

# ── Mail ─────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@your-domain.example"
MAIL_FROM_NAME="${APP_NAME}"

# Administrator Agreement — shown once after login. Who a declining
# administrator is told to contact; served to the app so it can change
# without a new build.
AGREEMENT_DISTRIBUTOR_NAME="Ginto Energies"
AGREEMENT_DISTRIBUTOR_CONTACT="harronandati@gmail.com"
